# копировать в .env и заполнять. .env в git НЕ коммитить!
TEAM_API_KEY=
SPARK_URL=https://api.external-services.dataprosvet.ru/spark/ws
SPARK_WSDL=https://api.external-services.dataprosvet.ru/spark/ws?wsdl
SPARK_LOGIN=
SPARK_PASSWORD=
ABS_URL=https://api.external-services.dataprosvet.ru/abs
# slow | timeout | error | unavailable | ratelimit (пусто = заголовок не отправляется)
MOCK_SCENARIO=

POSTGRES_USER=spark
POSTGRES_PASSWORD=spark
POSTGRES_DB=spark
DATABASE_URL=postgresql://spark:spark@postgres:5432/spark
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=3600

# Внешние порты
POSTGRES_PORT=5432
REDIS_PORT=6379

GATEWAY_TOKEN=change-me
UPSTREAM_TIMEOUT_SEC=0.9

# ML-модель: если файла нет в ./models, ml-model скачает его по MODEL_URL при старте
ML_MODEL_ADDR=ml-model:50051
MODEL_PATH=/models/company-scoring-v1.dill
MODEL_URL=
MODEL_TOKEN=
MODEL_SHA256=

# дата расчёта возраста компании в скоринге: today | data_as_of
SCORING_AS_OF=today

# Loader
# потоков при загрузке (все ждут общий лимитер СПАРК)
LOADER_WORKERS=8
# запросов в секунду к СПАРК на всю команду; если в логах много 429, поставь 4
RATE_LIMIT_RPS=5
# true: ничего не писать в БД, только проверить загрузку и разбор ответов (данные в памяти)
LOADER_DRY_RUN=false
# размер страницы в списках СПАРК (PageSize); 0 = не передавать (сервер отдаёт по 100)
SPARK_PAGE_SIZE=0
# valid_from версии SCD2: actual = ActualDate из отчёта СПАРК, load = время загрузки
SCD2_VALID_FROM=actual
