# копировать в .env и заполнять. .env в git НЕ коммитить!
TEAM_API_KEY=
SPARK_URL=https://api.external-services.dataprosvet.ru/spark/ws
SPARK_WSDL=https://api.external-services.dataprosvet.ru/spark/ws?wsdl
SPARK_LOGIN=
SPARK_PASSWORD=
ABS_URL=https://api.external-services.dataprosvet.ru/abs
# slow | timeout | error | unavailable | ratelimit (пусто = заголовок не отправляется)
MOCK_SCENARIO=

POSTGRES_USER=spark
POSTGRES_PASSWORD=spark
POSTGRES_DB=spark
DATABASE_URL=postgresql://spark:spark@postgres:5432/spark
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=3600

# Внешние порты
POSTGRES_PORT=5432
REDIS_PORT=6379

GATEWAY_TOKEN=change-me
UPSTREAM_TIMEOUT_SEC=0.9

# ML-модель: если файла нет в ./models, ml-model скачает его по MODEL_URL при старте
ML_MODEL_ADDR=ml-model:50051
MODEL_PATH=/models/company-scoring-v1.dill
MODEL_URL=
MODEL_TOKEN=
MODEL_SHA256=
